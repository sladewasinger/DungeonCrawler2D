#!/bin/bash
set -euxo pipefail

dnf install -y nodejs22
dnf install -y amazon-cloudwatch-agent
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli2 || dnf install -y awscli
fi

id dc2d >/dev/null 2>&1 || useradd --system --home-dir /opt/dungeoncrawler2d --shell /sbin/nologin dc2d
install -d -o dc2d -g dc2d /opt/dungeoncrawler2d /var/lib/dungeoncrawler2d /var/log/dungeoncrawler2d
operational_env=/var/lib/dungeoncrawler2d/operational-events.env
if [ ! -s "$operational_env" ] || ! grep -qxE 'OPERATIONAL_EVENT_PEPPER=[A-Za-z0-9+/=]{40,}' "$operational_env"; then
  set +x
  umask 077
  printf 'OPERATIONAL_EVENT_PEPPER=%s\n' "$(head -c 32 /dev/urandom | base64 -w0)" >"$operational_env"
  set -x
fi
chown dc2d:dc2d "$operational_env"
chmod 0600 "$operational_env"

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "agent": {
    "region": "${aws_region}"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/dungeoncrawler2d/server.log",
            "log_group_name": "${log_group_name}",
            "log_stream_name": "{instance_id}",
            "retention_in_days": ${server_log_retention_days}
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"]
      }
    }
  }
}
JSON

cat >/usr/local/bin/dc2d-sync <<'SCRIPT'
#!/bin/bash
set -euo pipefail
aws s3 cp "s3://${artifact_bucket}/${server_bundle_object}" /opt/dungeoncrawler2d/main.cjs --region "${aws_region}"
chown dc2d:dc2d /opt/dungeoncrawler2d/main.cjs
SCRIPT
chmod 0755 /usr/local/bin/dc2d-sync

cat >/etc/systemd/system/dungeoncrawler2d.service <<'UNIT'
[Unit]
Description=Dungeon Crawler 2D authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dc2d
Group=dc2d
WorkingDirectory=/opt/dungeoncrawler2d
Environment=NODE_ENV=production
Environment=DEBUG_COMMANDS=0
Environment=VOID_TERRAIN=false
Environment=GAME_PORT=8081
Environment=TRUST_PROXY=1
Environment=GAMEPLAY_IDLE_TIMEOUT_MS=180000
Environment=WORLD_SEED=${world_seed}
Environment=STORE_FILE=/var/lib/dungeoncrawler2d/players.json
Environment=CUSTOM_MAP=none
Environment=OPERATIONAL_EVENT_TABLE=${operational_event_table}
Environment=OPERATIONAL_EVENT_RETENTION_SECONDS=${operational_event_retention_seconds}
EnvironmentFile=/var/lib/dungeoncrawler2d/operational-events.env
ExecStartPre=+/usr/local/bin/dc2d-sync
ExecStart=/usr/bin/node /opt/dungeoncrawler2d/main.cjs
StandardOutput=append:/var/log/dungeoncrawler2d/server.log
StandardError=append:/var/log/dungeoncrawler2d/server.log
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/dungeoncrawler2d /var/lib/dungeoncrawler2d

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now amazon-cloudwatch-agent.service
systemctl enable --now dungeoncrawler2d.service
